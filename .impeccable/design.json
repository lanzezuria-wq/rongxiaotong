      "html": "<button class=\"ds-secondary\" type=\"button\">重新加载</button>",
      "css": ".ds-secondary{min-height:36px;padding:8px 15px;border:1px solid var(--el-border-color,#d8e0d9);border-radius:6px;background:var(--surface,#fff);color:var(--el-text-color-regular,#46534a);font-weight:500;cursor:pointer;transition:background-color .18s,border-color .18s,transform .18s;font-family:-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;font-size:14px;}.ds-secondary:hover{background:var(--el-color-primary-light-9,#edf4ef);color:var(--accent,#216448);border-color:var(--el-color-primary-light-7,#c0d7c7)}.ds-secondary:active{transform:translateY(1px);border-color:var(--accent,#216448)}.ds-secondary:focus-visible{outline:2px solid var(--el-color-primary-light-5,#8ab29b);outline-offset:1px}@media(max-width:767px){.ds-secondary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
