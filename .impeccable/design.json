      "description": "门户链接型按钮；悬停转深绿。",
      "html": "<a class=\"ds-button-link\" href=\"#products\">浏览农产品</a>",
      "css": ".ds-button-link{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 18px;border:0;border-radius:6px;background:var(--accent,#216448);color:var(--surface,#fff);font-weight:500;text-decoration:none;white-space:nowrap;font-family:-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;font-size:14px;}.ds-button-link:hover{background:var(--accent-strong,#174c36)}.ds-button-link:focus-visible{outline:3px solid #6b997b;outline-offset:4px;}.ds-button-link:active{transform:translateY(1px)}@media(max-width:767px){.ds-button-link{min-height:44px}}"
    },
    {
      "name": "业务主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Element Plus 业务主按钮；保留悬停、按下、焦点与禁用语义。",
      "html": "<button class=\"ds-primary\" type=\"button\">保存信息</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:8px 15px;border:1px solid var(--accent,#216448);border-radius:var(--el-border-radius-base,6px);background:var(--accent,#216448);color:#fff;font-weight:500;cursor:pointer;transition:background-color .18s,border-color .18s,transform .18s;font-family:-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;font-size:14px;}.ds-primary:hover:not(:disabled){background:var(--el-color-primary-light-3,#558a6f);border-color:var(--el-color-primary-light-3,#558a6f)}.ds-primary:active:not(:disabled){background:var(--accent-strong,#174c36);border-color:var(--accent-strong,#174c36);transform:translateY(1px)}.ds-primary:focus-visible{outline:2px solid var(--el-color-primary-light-5,#8ab29b);outline-offset:1px}.ds-primary:disabled{background:var(--el-color-primary-light-5,#8ab29b);border-color:var(--el-color-primary-light-5,#8ab29b);cursor:not-allowed}@media(max-width:767px){.ds-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
