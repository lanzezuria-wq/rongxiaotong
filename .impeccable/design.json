      "html": "<label class=\"ds-field-label\">商品名称<input class=\"ds-field\" placeholder=\"请输入商品名称\" /></label>",
      "css": ".ds-field-label{display:grid;gap:8px;color:var(--ink,#202f27);font-family:-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;font-size:14px;}.ds-field{min-height:40px;padding:1px 11px;border:0;border-radius:6px;background:var(--surface,#fff);color:var(--el-text-color-regular,#46534a);caret-color:var(--accent,#216448);box-shadow:0 0 0 1px var(--el-border-color,#d8e0d9) inset;font-family:-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;font-size:14px;}.ds-field::placeholder{color:var(--el-text-color-placeholder,#6d786f)}.ds-field:hover{box-shadow:0 0 0 1px var(--el-border-color-hover,#cdd0d6) inset}.ds-field:focus-visible{outline:none;box-shadow:0 0 0 1px var(--accent,#216448) inset}.ds-field[aria-invalid=\"true\"]{box-shadow:0 0 0 1px var(--danger,#b44435) inset}@media(max-width:767px){.ds-field{min-height:44px}}"
